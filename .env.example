DATABASE_URL="postgresql://user:password@localhost:5432/nexara?schema=public"

# ── Admin auth (required to open /admin) ──
# Password for the shared admin login. Without it the admin area stays locked.
ADMIN_PASSWORD=""
# Optional: key used to sign the admin session cookie. Falls back to ADMIN_PASSWORD.
# Rotate this to invalidate all existing admin sessions.
ADMIN_SESSION_SECRET=""

# ── Inquiry routing ──
# Where contact-form submissions are delivered (server-side only).
# CONTACT_TO_EMAIL="you@yourdomain.com"
# CONTACT_TO_NAME="Your Company"

# ── Resume storage ──
# Production uses a private Vercel Blob store. Connecting a Blob store to the
# project sets BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically. For local work
# (or non-Vercel hosts) run `vercel env pull`, or set a static token directly.
# BLOB_READ_WRITE_TOKEN=""
# When nothing is configured, uploads fall back to /public/uploads (dev only).

# ── Contact intake ──

# Public contact form posts to /api/inquiries (same origin, no extra config).
# Server-side storage mirrors resume storage: private Vercel Blob when the
# store is connected (BLOB_STORE_ID + VERCEL_OIDC_TOKEN, or BLOB_READ_WRITE_TOKEN),
# otherwise JSON files under .data/inquiries (local dev only). On Vercel without
# a Blob store, submissions are rejected with a 503 rather than lost.
#
# Optional: forward every accepted submission to your own system (CRM, email
# relay, Slack, PagerDuty). POSTs { type: "contact.inquiry.created", record }.
# Keep this secret — server-side only, never NEXT_PUBLIC_*.
# CONTACT_WEBHOOK_URL=""
#
# Notification routing: when set, the record carries these so the receiving
# system knows where the inquiry should be delivered.
# CONTACT_TO_EMAIL=""
# CONTACT_TO_NAME=""

# ── Owner notification email (optional) ──
# After an inquiry is accepted and stored, the server can email it to your
# inbox. Priority: RESEND_API_KEY (Resend HTTP API) → EMAIL_WEBHOOK_URL (your
# own relay). With neither set, nothing is sent and the API response records
# `emailed: false` — inquiries still land in storage.
# RESEND_API_KEY=""
# Verified-domain sender; "onboarding@resend.dev" works only as a test sender.
# EMAIL_FROM="Nexara Website <noreply@yourdomain.com>"
# Requires CONTACT_TO_EMAIL (the recipient) to be set as well.
# EMAIL_WEBHOOK_URL=""

# ── Careers intake webhooks ──
# Forward accepted job applications and talent profiles to your own system
# (ATS, CRM, email relay, Slack). POSTs { type: "careers.submission.created", record }.
# Keep these secret — server-side only, never NEXT_PUBLIC_*.
# CAREERS_WEBHOOK_URL=""

# ── Job listing applications ──
# Where "Apply by Email" mailto links point. Defaults to jay.nexara@gmail.com.
# This is only the seed/default: each job stores its own applyEmail (editable
# per listing in the admin panel), which wins over this default when set.
# JOBS_APPLY_EMAIL="careers@yourdomain.com"

NEXT_PUBLIC_INQUIRY_API="0"
NEXT_PUBLIC_INQUIRY_API_URL="/api/inquiries"

# ── Canonical site URL ──
# Optional. On Vercel the sitemap/robots/metadata already fall back to the
# project's production domain, so only set this to pin a specific form
# (e.g. https://www.nexara.com). Evaluated at build time.
# NEXT_PUBLIC_SITE_URL="https://www.nexara.com"
